<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <Button
        android:id="@+id/lockButton"
        style="@style/Dock.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/pomodoroMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.25"
        android:text="FOCUS"
        android:textColor="@color/accent"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@id/pomodoroTime"
        app:layout_constraintEnd_toEndOf="@id/pomodoroTime"
        app:layout_constraintStart_toStartOf="@id/pomodoroTime"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/pomodoroTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:text="25:00"
        android:textColor="@color/fg"
        android:textSize="150sp"
        app:layout_constraintBottom_toTopOf="@id/pomodoroButtons"
        app:layout_constraintEnd_toStartOf="@id/settingsCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pomodoroMode" />

    <LinearLayout
        android:id="@+id/pomodoroButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/pomodoroTime"
        app:layout_constraintStart_toStartOf="@id/pomodoroTime"
        app:layout_constraintTop_toBottomOf="@id/pomodoroTime">

        <Button
            android:id="@+id/pomodoroStart"
            style="@style/Dock.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:text="@string/start" />

        <Button
            android:id="@+id/pomodoroReset"
            style="@style/Dock.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/reset" />

        <Button
            android:id="@+id/pomodoroSkip"
            style="@style/Dock.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/skip" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/settingsCard"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.15"
            android:text="@string/durations"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/focus_length"
            android:textColor="@color/fg"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/focusMinus"
                style="@style/Dock.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:text="@string/minus" />

            <TextView
                android:id="@+id/focusValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="25 min"
                android:textColor="@color/fg"
                android:textSize="22sp" />

            <Button
                android:id="@+id/focusPlus"
                style="@style/Dock.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:text="@string/plus" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/break_length"
            android:textColor="@color/fg"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/breakMinus"
                style="@style/Dock.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:text="@string/minus" />

            <TextView
                android:id="@+id/breakValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="5 min"
                android:textColor="@color/fg"
                android:textSize="22sp" />

            <Button
                android:id="@+id/breakPlus"
                style="@style/Dock.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:text="@string/plus" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

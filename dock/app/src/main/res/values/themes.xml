<resources>
    <style name="Theme.Dock" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="alertDialogTheme">@style/Theme.Dock.Dialog</item>
    </style>

    <style name="Theme.Dock.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@color/card</item>
        <item name="android:textColorPrimary">@color/fg</item>
    </style>

    <style name="Dock.Button" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">@color/card</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minWidth">88dp</item>
    </style>

    <style name="Dock.Button.Glyph">
        <item name="android:textSize">28sp</item>
        <item name="android:minWidth">72dp</item>
    </style>
</resources>
